# This folder is a multi-project workspace — the YakoByTheSea repo tracks ONLY
# the game. Everything is ignored unless explicitly whitelisted below.
#
# NOTE: this repo is PUBLIC, and the Pages deploy serves the whole checkout. There is no
# longer a "strip internal files" step in the workflow and it is not needed: anything that
# must not be public is simply not whitelisted here. CLAUDE.md, docs/ and the voice review
# tools are excluded for that reason. Stripping at deploy time would not have helped anyway
# -- it cleans the published site, not the repository, which anyone can read.
/*

# --- the game ---
!/.gitignore
!/README.md
!/index.html
!/keyboard-fun.html
!/privacy.html
!/terms.html
!/robots.txt
!/sitemap.xml
!/llms.txt
!/favicon.ico
!/favicon*.png
!/.github/
!/manifest.webmanifest
!/sw.js

# code + data + tools
!/js/
!/data/
!/tools/

# self-hosted webfonts (replaced the Google Fonts <link>; the game 404s without them)
!/fonts/

# art & video the game loads
!/background.jpg
!/gameui.png
!/freepanel.png
!/gameui_anim.mp4
!/home_bg.mp4
!/reactions.mp4
!/scene1.png
!/scene2.png
!/scene3.png
!/scene4.png
!/scene5.png
!/scene6.png
!/yako.png
!/yako_cheer.png
!/theme.mp3
!/scenes/
!/video/
!/music/
!/objects/
!/decor/

# UI kit (excluding local art backups)
!/ui/
ui/_orig_art/
ui/_framed_orig/
ui/_orig_btns/

# recorded narration. The clip-review TOOLS are deliberately not published: they are
# internal dev pages, nothing links to them, and every tracked file is served live on a
# site aimed at children. They stay on disk for local use, just out of the deploy.
!/voice/
/voice/src_*.mp3
/voice/clip-marker.html
/voice/review-persona.html
/voice/review.html
# scratch voice auditions -- never loaded by the game, no reason to publish them
/voice/_yako_candidates/

# OS noise
.DS_Store

!/dance/
