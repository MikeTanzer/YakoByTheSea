# This folder is a multi-project workspace — the YakoByTheSea repo tracks ONLY
# the game. Everything is ignored unless explicitly whitelisted below.
#
# NOTE: this repo is PUBLIC. CLAUDE.md and docs/ are deliberately NOT whitelisted:
# .github/workflows/static.yml strips them from the published SITE, but anything
# committed here is readable by anyone browsing the repository regardless.
/*

# --- the game ---
!/.gitignore
!/README.md
!/index.html
!/keyboard-fun.html
!/privacy.html
!/terms.html
!/robots.txt
!/sitemap.xml
!/llms.txt
!/favicon.ico
!/favicon*.png
!/.github/
!/manifest.webmanifest
!/sw.js

# code + data + tools
!/js/
!/data/
!/tools/

# self-hosted webfonts (replaced the Google Fonts <link>; the game 404s without them)
!/fonts/

# art & video the game loads
!/background.jpg
!/gameui.png
!/freepanel.png
!/gameui_anim.mp4
!/home_bg.mp4
!/reactions.mp4
!/scene1.png
!/scene2.png
!/scene3.png
!/scene4.png
!/scene5.png
!/scene6.png
!/yako.png
!/yako_cheer.png
!/theme.mp3
!/scenes/
!/video/
!/music/
!/objects/
!/decor/

# UI kit (excluding local art backups)
!/ui/
ui/_orig_art/
ui/_framed_orig/
ui/_orig_btns/

# recorded narration + the clip-review tools (raw source recordings excluded)
!/voice/
/voice/src_*.mp3
# scratch voice auditions -- never loaded by the game, no reason to publish them
/voice/_yako_candidates/

# OS noise
.DS_Store

!/dance/
